# Browser CORS allowlist; comma-separated explicit HTTP(S) origins only.
# Wildcards, URL paths, credentials, queries, and fragments are rejected.
# Local development default; add exact frontend origins if hosting elsewhere.
FRONTEND_ORIGINS=http://localhost:5173

# Shared intelligence core (Inception Labs Mercury)
INTELLIGENCE_CORE_ENABLED=false
INTELLIGENCE_CORE_PROVIDER=mercury
INCEPTION_API_KEY=
INCEPTION_MODEL=mercury-3

# Optional legacy provider (only if intentionally selected)
# INTELLIGENCE_CORE_PROVIDER=freellmapi
# FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
# FREELLMAPI_API_KEY=
# FREELLMAPI_MODEL=auto

# Legacy Ollama settings (not the default provider)
# INTELLIGENCE_CORE_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=phi3
