# Copy to .env.local before running. Never commit real credentials.

# PostgreSQL connection string used by Drizzle ORM.
# If unset, the app still runs: /api/health reports database=unconfigured
# and research endpoints return an explicit database-unavailable error.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/market_mind_ai

# Optional adapter to the existing MARKET-MIND-AI FastAPI research backend.
# Leave unset to keep this landing page fully self-contained.
MARKET_MIND_API_URL=http://127.0.0.1:8001
MARKET_MIND_API_TOKEN=
MARKET_MIND_API_TIMEOUT_MS=5000
