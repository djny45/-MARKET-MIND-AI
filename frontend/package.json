{
  "name": "market-mind-terminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest",
    "test:all": "npm test && npm run test:ui",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@xyflow/react": "^13.0.2",
    "lightweight-charts": "^5.0.8",
    "lucide-react": "^1.76.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "esbuild": "^0.28.2",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.4.6",
    "vitest": "^5.1.1"
  }
}
