# Browser CORS allowlist; comma-separated frontend origin(s).
# Local development default; add your frontend origin if hosting elsewhere.
FRONTEND_ORIGINS=http://localhost:5173

# Shared intelligence core (Inception Labs Mercury)
INTELLIGENCE_CORE_ENABLED=false
INTELLIGENCE_CORE_PROVIDER=mercury
INCEPTION_API_KEY=
INCEPTION_MODEL=mercury-3

# Optional legacy provider (only if intentionally selected)
# INTELLIGENCE_CORE_PROVIDER=freellmapi
# FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
# FREELLMAPI_API_KEY=
# FREELLMAPI_MODEL=auto

# Legacy Ollama settings (not the default provider)
# INTELLIGENCE_CORE_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=phi3

# Optional Stooq historical-data credential. Leave empty when the provider permits public CSV access.
# This key is used only by the read-only daily historical adapter; it never enables trading.
STOOQ_API_KEY=

# Single-owner API authentication (never commit the generated hash).
MARKET_MIND_AUTH_REQUIRED=true
MARKET_MIND_AUTH_DB=/data/auth_sessions.sqlite3
MARKET_MIND_OWNER_PASSWORD_HASH=
MARKET_MIND_SESSION_IDLE_TTL=1800
MARKET_MIND_SESSION_ABSOLUTE_TTL=43200
# Keep true behind HTTPS. The loopback-only Compose development stack overrides this to false.
MARKET_MIND_COOKIE_SECURE=true
