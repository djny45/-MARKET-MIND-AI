# TLS ingress example for MARKET-MIND-AI (research-only deployment)
#
# TEMPLATE ONLY — not an executed host configuration. Replace server_name and
# certificate paths, validate with `nginx -t`, and reload only after an
# authorized operator has reviewed it. Host-level acceptance (certificate
# issuance/renewal, HSTS preload, external scan) is operator work and is NOT
# claimed by this repository.
#
# The backend and SQLite must stay on a private network. Only this TLS ingress
# is exposed; the FastAPI service and database are never published directly.

limit_req_zone $binary_remote_addr zone=mm_api:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=mm_page:10m rate=120r/m;

server {
    listen 80;
    server_name research.example.invalid;
    # Never serve application traffic over plaintext.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name research.example.invalid;

    ssl_certificate     /etc/letsencrypt/live/research.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/research.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;
    ssl_stapling on;
    ssl_stapling_verify on;

    # Reverse-proxy security headers.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'" always;

    client_max_body_size 2m;

    # Ingress-level rate limits are required in addition to the application
    # limiter. The app's trusted-proxy count must match the number of hops.
    location /api/ {
        limit_req zone=mm_api burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8080/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }

    location / {
        limit_req zone=mm_page burst=40 nodelay;
        proxy_pass http://127.0.0.1:8080/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
}
