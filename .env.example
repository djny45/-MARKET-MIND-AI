# Private research-mode template. Copy OUTSIDE the repository, chmod 0600,
# fill in operator-generated scrypt hashes (never plaintext passwords), and
# start with: docker compose --env-file /secure/private.env up -d --build
#
# This file contains placeholders only. No secret value belongs in Git.
FRONTEND_ORIGINS=http://127.0.0.1:8080
MARKET_MIND_USER_AUTH=true
MARKET_MIND_USERS=[{"username":"admin","password_hash":"<scrypt hash>","role":"admin"}]
MARKET_MIND_REQUIRE_ORIGIN=true
MARKET_MIND_COOKIE_SAMESITE=strict
MARKET_MIND_SECURE_COOKIES=false
API_RATE_LIMIT_PER_MINUTE=30

# Research-only boundary: the virtual-paper trading loop is OFF by default.
# Leave unset to keep the API research-only (no paper routes, no simulated loop).
# Only set to 1/true/yes/on for an explicitly authorized paper simulation.
# MM_PAPER_ENABLED=

# Optional integrations. Leave empty unless the owner has authorized them.
# N8N_REVIEWER_TOKENS_JSON=
# N8N_BASE_URL=
# N8N_API_KEY=
# MARKET_MIND_INCIDENT_WEBHOOK_URL=
