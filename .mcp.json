{
  "mcpServers": {
    "market-mind-ai": {
      "command": "python",
      "args": [
        "backend/app/mcp_server.py"
      ]
    },
    "camofox-browser": {
      "command": "npx",
      "args": [
        "-y",
        "@askjo/camofox-browser-mcp"
      ],
      "env": {
        "CAMOFOX_BASE_URL": "http://127.0.0.1:9377"
      }
    }
  }
}
