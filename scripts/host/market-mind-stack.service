# MARKET-MIND-AI private research stack — supervision unit
#
# INSTALL (requires root on the real host; not run in this container):
#   sudo cp scripts/host/market-mind-stack.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now market-mind-stack.service
#
# This unit only calls the bootstrap script, which is idempotent and refuses to
# run with an insecure env file. Loopback only: no public ingress, no broker.

[Unit]
Description=MARKET-MIND-AI private research stack (backend, proxy, supervisor, backups)
Documentation=file:///home/jovyan/-MARKET-MIND-AI/docs/OPERATIONS-RUNBOOK.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=oneshot
User=jovyan
Group=users
WorkingDirectory=/home/jovyan/-MARKET-MIND-AI
ExecStart=/home/jovyan/.market-mind-ops/bootstrap.sh
ExecStop=/home/jovyan/.market-mind-ops/supervision/service_manager.py stop
RemainAfterExit=yes
# oneshot: systemd re-checks on next boot/restart; the loop self-heals services.
TimeoutStartSec=120
TimeoutStopSec=60
# Hardening: the service needs no privileges beyond its own data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Home must be writable: the app venv and the ops directory both live there.
ProtectHome=false
ReadWritePaths=/home/jovyan/.market-mind-ops /home/jovyan/-MARKET-MIND-AI
# Secrets come from the 0600 env file read by the app, never from this unit.

[Install]
WantedBy=multi-user.target
